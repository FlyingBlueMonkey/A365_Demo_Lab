{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.20/MicrosoftTeams.schema.json",
  "manifestVersion": "1.20",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "A365 Demo Lab",
    "websiteUrl": "{{WEBSITE_URL}}",
    "privacyUrl": "{{PRIVACY_URL}}",
    "termsOfUseUrl": "{{TERMS_URL}}"
  },
  "name": {
    "short": "Chat Summary Assistant",
    "full": "Teams Chat Summary Assistant"
  },
  "description": {
    "short": "Summarize recent messages in a Teams group chat.",
    "full": "Mention Chat Summary Assistant with summarize this chat to receive a bounded summary of recent group-chat messages, decisions, action items, and open questions. Selected messages are processed by the configured OpenAI model."
  },
  "icons": {"outline": "outline.png", "color": "color.png"},
  "accentColor": "#087F8C",
  "bots": [{
    "botId": "{{TEAMS_BOT_CLIENT_ID}}",
    "scopes": ["groupChat"],
    "isNotificationOnly": false,
    "supportsFiles": false,
    "commandLists": [{
      "scopes": ["groupChat"],
      "commands": [{"title": "summarize", "description": "Summarize recent messages in this chat"}]
    }]
  }],
  "authorization": {
    "permissions": {
      "resourceSpecific": [{"name": "ChatMessage.Read.Chat", "type": "Application"}]
    }
  },
  "webApplicationInfo": {
    "id": "{{TEAMS_BOT_CLIENT_ID}}",
    "resource": "api://{{TEAMS_BOT_CLIENT_ID}}"
  },
  "validDomains": []
}